
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USER
// ==========================================

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  location  String?
  avatarUrl String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())

  comments      Comment[]
  reactions     CommentReaction[]
  reports       CommentReport[]
  histories     CommentHistory[] @relation("HistoryActor")
  subscriptions UserSubscription[]
  downloads     Download[]
  payments      Payment[]
}

// ==========================================
// COMMENTS
// ==========================================

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  language  String?
  isEdited  Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  parentId Int?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  reactions CommentReaction[]
  reports   CommentReport[]
  histories CommentHistory[]
}

// ==========================================
// COMMENT REACTIONS
// ==========================================

model CommentReaction {
  id        Int          @id @default(autoincrement())
  type      ReactionType
  createdAt DateTime     @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  commentId Int
  comment   Comment @relation(fields: [commentId], references: [id])

  @@unique([userId, commentId])
}

// ==========================================
// COMMENT REPORTS
// ==========================================

model CommentReport {
  id        Int          @id @default(autoincrement())
  reason    ReportReason
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  reporterId Int
  reporter   User @relation(fields: [reporterId], references: [id])

  commentId Int
  comment   Comment @relation(fields: [commentId], references: [id])

  @@unique([reporterId, commentId])
}

// ==========================================
// COMMENT HISTORY
// ==========================================

model CommentHistory {
  id     Int           @id @default(autoincrement())
  action HistoryAction

  oldContent String?
  newContent String?

  createdAt DateTime @default(now())

  commentId Int
  comment   Comment @relation(fields: [commentId], references: [id])

  actorId Int
  actor   User @relation("HistoryActor", fields: [actorId], references: [id])
}

// ==========================================
// SUBSCRIPTION SYSTEM
// ==========================================

model SubscriptionPlan {
  id            Int     @id @default(autoincrement())
  name          String  @unique
  price         Decimal @db.Decimal(10, 2)
  durationDays  Int
  downloadLimit Int
  maxFileSizeMB Int

  // MEMBERSHIP FEATURES
  premiumVideoAccess Boolean @default(false)
  streamingQuality   String  @default("LOW")
  watchTimeMinutes   Int     @default(60)

  offlineDownloads Boolean @default(false)
  adFreeViewing    Boolean @default(false)
  priorityContent  Boolean @default(false)
  exclusiveCourses Boolean @default(false)

  createdAt DateTime @default(now())

  subscriptions UserSubscription[]
  payments      Payment[]
}

// ==========================================
// USER SUBSCRIPTIONS
// ==========================================

model UserSubscription {
  id            Int      @id @default(autoincrement())
  userId        Int
  planId        Int
  startDate     DateTime @default(now())
  endDate       DateTime
  isActive      Boolean  @default(true)
  downloadsUsed Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  payments Payment[]

  @@index([userId])
  @@index([planId])
}

// ==========================================
// PAYMENT / BILLING SYSTEM
// ==========================================

model Payment {
  id Int @id @default(autoincrement())

  // USER / SUBSCRIPTION INFORMATION
  userId         Int
  planId         Int
  subscriptionId Int?

  user         User              @relation(fields: [userId], references: [id])
  plan         SubscriptionPlan  @relation(fields: [planId], references: [id])
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id])

  // INVOICE INFORMATION
  invoiceNumber String? @unique

  // RAZORPAY INFORMATION
  razorpayOrderId   String  @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  // PAYMENT DETAILS
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  status PaymentStatus @default(CREATED)

  failureReason String?

  // TIMESTAMPS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([subscriptionId])
  @@index([status])
}

// ==========================================
// DOWNLOAD MANAGEMENT
// ==========================================

model Download {
  id          Int            @id @default(autoincrement())
  userId      Int
  videoUrl    String
  videoTitle  String?
  status      DownloadStatus @default(PENDING)
  fileName    String?
  fileSizeMB  Int?
  createdAt   DateTime       @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// ==========================================
// ENUMS
// ==========================================

enum ReactionType {
  LIKE
  DISLIKE
}

enum ReportReason {
  SPAM
  HARASSMENT
  OFFENSIVE_CONTENT
  HATE_SPEECH
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum UserRole {
  USER
  ADMIN
}

enum HistoryAction {
  EDIT
  DELETE
}

enum DownloadStatus {
  PENDING
  DOWNLOADING
  COMPLETED
  FAILED
  CANCELLED
}

// ==========================================
// PAYMENT STATUS
// ==========================================

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}
